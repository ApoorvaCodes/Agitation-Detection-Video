{
  "$defs": {
    "ActionAssessment": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "title": "Person Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "scored",
            "low_quality",
            "contact_unavailable",
            "contact_unclear",
            "incompatible_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "contact_present": {
          "default": false,
          "title": "Contact Present",
          "type": "boolean"
        },
        "positive_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Similarity"
        },
        "negative_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Similarity"
        },
        "contrast_margin": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contrast Margin"
        },
        "contacts": {
          "items": {
            "$ref": "#/$defs/ContactObservation"
          },
          "title": "Contacts",
          "type": "array"
        }
      },
      "required": [
        "person_id",
        "chunk_id",
        "item_id",
        "status",
        "reason"
      ],
      "title": "ActionAssessment",
      "type": "object"
    },
    "ActionAsset": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "masked_two_centroid_classifier_v1",
          "default": "masked_two_centroid_classifier_v1",
          "title": "Model",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "title": "ActionAsset",
      "type": "object"
    },
    "ActionEvidenceResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cmai-action-assessments-1.0",
          "default": "cmai-action-assessments-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "recording_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recording Sha256"
        },
        "provider_identity": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Identity"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/ActionAssessment"
          },
          "title": "Assessments",
          "type": "array"
        }
      },
      "required": [
        "video_id",
        "assessments"
      ],
      "title": "ActionEvidenceResult",
      "type": "object"
    },
    "ActionQuality": {
      "additionalProperties": false,
      "properties": {
        "min_detection_confidence": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Detection Confidence",
          "type": "number"
        },
        "min_landmark_visibility": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Landmark Visibility",
          "type": "number"
        },
        "min_absent_contact_fraction": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Absent Contact Fraction",
          "type": "number"
        }
      },
      "title": "ActionQuality",
      "type": "object"
    },
    "BehaviourScore": {
      "additionalProperties": false,
      "properties": {
        "behaviour": {
          "title": "Behaviour",
          "type": "string"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        },
        "smoothed_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoothed Similarity"
        },
        "shared_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Shared Fraction",
          "type": "number"
        },
        "candidate": {
          "default": false,
          "title": "Candidate",
          "type": "boolean"
        }
      },
      "required": [
        "behaviour",
        "shared_fraction"
      ],
      "title": "BehaviourScore",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y Max",
          "type": "number"
        },
        "coordinate_system": {
          "default": "normalized",
          "title": "Coordinate System",
          "type": "string"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CameraEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "taxonomy_version": {
          "const": "cmai-long-form-camera-v1",
          "default": "cmai-long-form-camera-v1",
          "title": "Taxonomy Version",
          "type": "string"
        },
        "cmai_item_id": {
          "title": "Cmai Item Id",
          "type": "string"
        },
        "canonical_cmai_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Cmai Id"
        },
        "canonical_cmai_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Cmai Name"
        },
        "model_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Model Status",
          "type": "string"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "reviewed_confirmed",
            "reviewed_rejected",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "start_timestamp": {
          "minimum": 0,
          "title": "Start Timestamp",
          "type": "number"
        },
        "end_timestamp": {
          "exclusiveMinimum": 0,
          "title": "End Timestamp",
          "type": "number"
        },
        "score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        },
        "score_semantics": {
          "default": "uncalibrated_cosine_similarity",
          "enum": [
            "uncalibrated_cosine_similarity",
            "demo_rule_evidence_strength_not_probability",
            "heuristic_motion_score"
          ],
          "title": "Score Semantics",
          "type": "string"
        },
        "source_label": {
          "title": "Source Label",
          "type": "string"
        },
        "source_candidate_id": {
          "title": "Source Candidate Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/CandidateEvidence"
        },
        "quality": {
          "$ref": "#/$defs/CandidateQuality"
        },
        "review_history": {
          "items": {
            "$ref": "#/$defs/ReviewDecision"
          },
          "title": "Review History",
          "type": "array"
        },
        "evidence_check": {
          "additionalProperties": true,
          "title": "Evidence Check",
          "type": "object"
        },
        "machine_validation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Validation"
        }
      },
      "required": [
        "event_id",
        "cmai_item_id",
        "start_timestamp",
        "end_timestamp",
        "score",
        "source_label",
        "source_candidate_id",
        "evidence",
        "quality",
        "evidence_check"
      ],
      "title": "CameraEvent",
      "type": "object"
    },
    "CandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "minLength": 1,
          "title": "Video Id",
          "type": "string"
        },
        "person_id": {
          "minLength": 1,
          "title": "Person Id",
          "type": "string"
        },
        "chunk_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Chunk Ids",
          "type": "array"
        },
        "frame_indices": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Frame Indices",
          "type": "array"
        },
        "clip_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Path"
        },
        "clip_status": {
          "default": "pending",
          "enum": [
            "pending",
            "available",
            "unavailable"
          ],
          "title": "Clip Status",
          "type": "string"
        },
        "clip_start_timestamp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Start Timestamp"
        },
        "contacts": {
          "items": {
            "$ref": "#/$defs/ContactObservation"
          },
          "title": "Contacts",
          "type": "array"
        },
        "demo_evidence": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Demo Evidence"
        }
      },
      "required": [
        "video_id",
        "person_id",
        "chunk_ids",
        "frame_indices"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "CandidateQuality": {
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "default": "unknown",
          "enum": [
            "adequate",
            "limited",
            "unknown"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "occlusion_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occlusion Fraction"
        },
        "min_valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Min Valid Fraction",
          "type": "number"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "confirmed",
            "rejected",
            "uncertain"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "min_valid_fraction"
      ],
      "title": "CandidateQuality",
      "type": "object"
    },
    "ContactObservation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "person_id": {
          "minLength": 1,
          "title": "Person Id",
          "type": "string"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "timestamp": {
          "minimum": 0,
          "title": "Timestamp",
          "type": "number"
        },
        "limb": {
          "enum": [
            "left_hand",
            "right_hand",
            "left_foot",
            "right_foot"
          ],
          "title": "Limb",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "person",
            "self",
            "object"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "target_visible": {
          "title": "Target Visible",
          "type": "boolean"
        },
        "actor_limb_visible": {
          "title": "Actor Limb Visible",
          "type": "boolean"
        },
        "contact": {
          "enum": [
            "observed",
            "absent",
            "unclear"
          ],
          "title": "Contact",
          "type": "string"
        },
        "evidence_reference": {
          "minLength": 1,
          "title": "Evidence Reference",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "person_id",
        "frame_index",
        "timestamp",
        "limb",
        "target_kind",
        "target_id",
        "target_bbox",
        "target_visible",
        "actor_limb_visible",
        "contact",
        "evidence_reference"
      ],
      "title": "ContactObservation",
      "type": "object"
    },
    "CoverageInterval": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "segment_id": {
          "minimum": 0,
          "title": "Segment Id",
          "type": "integer"
        },
        "start_timestamp": {
          "minimum": 0,
          "title": "Start Timestamp",
          "type": "number"
        },
        "end_timestamp": {
          "exclusiveMinimum": 0,
          "title": "End Timestamp",
          "type": "number"
        },
        "valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Fraction",
          "type": "number"
        },
        "status": {
          "enum": [
            "scored",
            "low_quality",
            "no_prototypes",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/BehaviourScore"
          },
          "title": "Scores",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "segment_id",
        "start_timestamp",
        "end_timestamp",
        "valid_fraction",
        "status",
        "scores"
      ],
      "title": "CoverageInterval",
      "type": "object"
    },
    "DetectorBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "taxonomy_version": {
          "const": "cmai-long-form-camera-v1",
          "default": "cmai-long-form-camera-v1",
          "title": "Taxonomy Version",
          "type": "string"
        },
        "detector_id": {
          "minLength": 1,
          "title": "Detector Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "unavailable",
            "research",
            "released",
            "legacy_review"
          ],
          "title": "Mode",
          "type": "string"
        },
        "configuration": {
          "$ref": "#/$defs/Person2Config"
        },
        "pose_representation": {
          "default": "stats",
          "enum": [
            "stats",
            "time-bins"
          ],
          "title": "Pose Representation",
          "type": "string"
        },
        "temporal_bins": {
          "default": 4,
          "minimum": 2,
          "title": "Temporal Bins",
          "type": "integer"
        },
        "prototype_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prototype File"
        },
        "prototype_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prototype Sha256"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/DetectorRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "release_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detector_mode": {
          "default": "pose_motion_camera",
          "enum": [
            "pose_motion_camera",
            "interaction_actions"
          ],
          "title": "Detector Mode",
          "type": "string"
        },
        "declared_labels": {
          "items": {
            "type": "string"
          },
          "title": "Declared Labels",
          "type": "array"
        },
        "action_asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionAsset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action_quality": {
          "$ref": "#/$defs/ActionQuality"
        },
        "video_encoder": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalVideoEncoder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "detector_id",
        "version",
        "mode",
        "configuration"
      ],
      "title": "DetectorBundle",
      "type": "object"
    },
    "DetectorRule": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "similarity_threshold": {
          "maximum": 1,
          "minimum": -1,
          "title": "Similarity Threshold",
          "type": "number"
        },
        "min_consecutive_chunks": {
          "default": 2,
          "minimum": 2,
          "title": "Min Consecutive Chunks",
          "type": "integer"
        },
        "min_event_seconds": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Min Event Seconds",
          "type": "number"
        },
        "min_evidence_fraction": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Evidence Fraction",
          "type": "number"
        },
        "contrast_margin": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Contrast Margin",
          "type": "number"
        }
      },
      "required": [
        "item_id",
        "similarity_threshold"
      ],
      "title": "DetectorRule",
      "type": "object"
    },
    "ItemAvailability": {
      "additionalProperties": false,
      "properties": {
        "cmai_item_id": {
          "title": "Cmai Item Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "research_only",
            "unavailable",
            "not_assessed_by_camera"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cmai_item_id",
        "status",
        "reason"
      ],
      "title": "ItemAvailability",
      "type": "object"
    },
    "LocalVideoEncoder": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "torchvision_r3d_18_kinetics400_v1",
          "title": "Model",
          "type": "string"
        },
        "checkpoint_file": {
          "minLength": 1,
          "title": "Checkpoint File",
          "type": "string"
        },
        "checkpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "source": {
          "const": "https://download.pytorch.org/models/r3d_18-b3b3357e.pth",
          "title": "Source",
          "type": "string"
        },
        "clip_frames": {
          "const": 16,
          "default": 16,
          "title": "Clip Frames",
          "type": "integer"
        },
        "sample_fps": {
          "const": 15,
          "default": 15,
          "title": "Sample Fps",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "checkpoint_file",
        "checkpoint_sha256",
        "source"
      ],
      "title": "LocalVideoEncoder",
      "type": "object"
    },
    "Person2Config": {
      "properties": {
        "window_seconds": {
          "default": 2.0,
          "title": "Window Seconds",
          "type": "number"
        },
        "overlap": {
          "default": 0.5,
          "title": "Overlap",
          "type": "number"
        },
        "max_gap_seconds": {
          "default": 1.0,
          "title": "Max Gap Seconds",
          "type": "number"
        },
        "min_frames": {
          "default": 3,
          "title": "Min Frames",
          "type": "integer"
        },
        "min_valid_fraction": {
          "default": 0.6,
          "title": "Min Valid Fraction",
          "type": "number"
        },
        "min_shared_fraction": {
          "default": 0.5,
          "title": "Min Shared Fraction",
          "type": "number"
        },
        "similarity_threshold": {
          "default": 0.8,
          "title": "Similarity Threshold",
          "type": "number"
        },
