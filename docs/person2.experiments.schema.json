{
  "$defs": {
    "DatasetProvenance": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "annotation_protocol": {
          "minLength": 1,
          "title": "Annotation Protocol",
          "type": "string"
        },
        "annotation_version": {
          "minLength": 1,
          "title": "Annotation Version",
          "type": "string"
        },
        "license_or_permission": {
          "minLength": 1,
          "title": "License Or Permission",
          "type": "string"
        },
        "label_agreement": {
          "minLength": 1,
          "title": "Label Agreement",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "annotation_protocol",
        "annotation_version",
        "license_or_permission",
        "label_agreement"
      ],
      "title": "DatasetProvenance",
      "type": "object"
    },
    "LabelledChunk": {
      "additionalProperties": false,
      "properties": {
        "perception": {
          "minLength": 1,
          "title": "Perception",
          "type": "string"
        },
        "person_id": {
          "minLength": 1,
          "title": "Person Id",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "annotation_id": {
          "minLength": 1,
          "title": "Annotation Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "perception",
        "person_id",
        "chunk_id",
        "subject_id",
        "session_id",
        "annotation_id",
        "split",
        "labels"
      ],
      "title": "LabelledChunk",
      "type": "object"
    },
    "Person2Config": {
      "properties": {
        "window_seconds": {
          "default": 2.0,
          "title": "Window Seconds",
          "type": "number"
        },
        "overlap": {
          "default": 0.5,
          "title": "Overlap",
          "type": "number"
        },
        "max_gap_seconds": {
          "default": 1.0,
          "title": "Max Gap Seconds",
          "type": "number"
        },
        "min_frames": {
          "default": 3,
          "title": "Min Frames",
          "type": "integer"
        },
        "min_valid_fraction": {
          "default": 0.6,
          "title": "Min Valid Fraction",
          "type": "number"
        },
        "min_shared_fraction": {
          "default": 0.5,
          "title": "Min Shared Fraction",
          "type": "number"
        },
        "similarity_threshold": {
          "default": 0.8,
          "title": "Similarity Threshold",
          "type": "number"
        },
        "smoothing_alpha": {
          "default": 0.5,
          "title": "Smoothing Alpha",
          "type": "number"
        },
        "min_event_seconds": {
          "default": 1.0,
          "title": "Min Event Seconds",
          "type": "number"
        },
        "pose_weight": {
          "default": 1.0,
          "title": "Pose Weight",
          "type": "number"
        },
        "motion_weight": {
          "default": 1.0,
          "title": "Motion Weight",
          "type": "number"
        },
        "video_weight": {
          "default": 1.0,
          "title": "Video Weight",
          "type": "number"
        }
      },
      "title": "Person2Config",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "taxonomy_version": {
      "const": "cmai-long-form-camera-v1",
      "default": "cmai-long-form-camera-v1",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "detector_mode": {
      "const": "pose_motion_camera",
      "default": "pose_motion_camera",
      "title": "Detector Mode",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/DatasetProvenance"
    },
    "behaviours": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Behaviours",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/LabelledChunk"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "event_annotations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Event Annotations",
      "type": "array"
    },
    "reviewed_intervals": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Reviewed Intervals",
      "type": "array"
    },
    "chunk_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Person2Config"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provenance",
    "behaviours",
    "records"
  ],
  "title": "ExperimentManifest",
  "type": "object"
}
